    def compute_intersection(self, line1, line2):
        """
        두 [[x1, y1, x2, y2]] 자료형으로 나타내어진 직선들의 교점을 선형대수학적 연산을 통해 계산한다.
        gets: [[x1, y1, x2, y2]] 자료형으로 나타내어진 직선 2개
        returns: int(x), int(y) (or None => 두 직선이 평행할 때)
        """
        x1, y1, x2, y2 = line1[0]
        x3, y3, x4, y4 = line2[0]

        # Line 1 coefficients
        A1 = y2 - y1
        B1 = x1 - x2
        C1 = A1 * x1 + B1 * y1

        # Line 2 coefficients
        A2 = y4 - y3
        B2 = x3 - x4
        C2 = A2 * x3 + B2 * y3

        # Determinant
        det = A1 * B2 - A2 * B1

        if det == 0:
            return None  # Lines are parallel or coincident

        # Cramer's Rule
        x = (B2 * C1 - B1 * C2) / det
        y = (A1 * C2 - A2 * C1) / det
        return int(x), int(y)




    def follow_lane(self):
        # <20250804> Setting exposure
        os.system(f'v4l2-ctl -d /dev/videoCAM -c exposure_time_absolute={self.EXPOSURE}')
        
        # angle 초기화
        angle = 0

        image = self._image
        # === 2. Convert to grayscale and apply Canny ===
        # 흑백 이미지 생성
        frame = image.copy()

        # =========================== < Generalize된 hough transform 전처리 > ===========================
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
        
        # 흑백 이미지에 GaussianBlur
        blur = cv2.GaussianBlur(gray, (5, 5), 0)
        
        # blur 이미지에 Canny 변환해서 Edge detection
        edges = cv2.Canny(blur, 50, 150)
        
        # cv2.imshow("canny", edges) 

        # =================================== < ROI focused 전처리 > ===================================
        hsv_yellow = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)

        lower_yellow = np.array([20, 100, 60])
        upper_yellow = np.array([40, 255, 255])

        mask_yellow = cv2.inRange(hsv_yellow, lower_yellow, upper_yellow)
        yellow_parts = cv2.bitwise_and(image, image, mask=mask_yellow)

        gray_yellow = cv2.cvtColor(yellow_parts, cv2.COLOR_BGR2GRAY)
        blur_yellow = cv2.GaussianBlur(gray_yellow, (5, 5), 0)

        edges_yellow = cv2.Canny(blur_yellow, 50, 150)

        # cv2.imshow("gray_yellow", gray_yellow) 

        # ============================================================================================= 
        height, width = image.shape[:2]
        baseline_y_pixel = int(height * self.baseline_y_rate)

        base_line = [[0, baseline_y_pixel, width, baseline_y_pixel]]

        roi_vertices = np.array([[
            (width * 0, height),
            (width * 0.3, height * 0.7),
            (width * 0.7, height * 0.7),
            (width * 1, height)
        ]], dtype=np.int32)

        roi_vertices_focused = np.array([[
            (width * 0.1, height * 1.0),
            (width * 0.1, height * 0.6),
            (width * 0.9, height * 0.6),
            (width * 0.9, height * 1.0)
        ]], dtype=np.int32)

        cv2.polylines(frame, roi_vertices, isClosed=True, color=(0, 255, 255), thickness=2)
        
        roi_edges = self.region_of_interest(edges, roi_vertices)
        roi_yellow_edges = self.region_of_interest(edges_yellow, roi_vertices)

        lines = cv2.HoughLinesP(
            roi_edges, rho=1, theta=np.pi/180, threshold=50,
            minLineLength=70, maxLineGap=10
        )

        if self.drive_state == self.DRIVE_STATE_STRAIGHT:
            left_lines, right_lines = self.filter_lines(lines, self.THRESHOLD_SLOPE_FILTER, split_frame=True)
        elif self.drive_state == self.DRIVE_STATE_CURVE:
            left_lines, right_lines = self.filter_lines(lines, self.THRESHOLD_SLOPE_FILTER, split_frame=False)
        elif self.drive_state == self.DRIVE_STATE_S_CURVE:
            left_lines, right_lines = self.filter_lines(lines, self.THRESHOLD_SLOPE_FILTER, split_frame=False)

        lines_yellow = cv2.HoughLinesP(
            roi_yellow_edges, rho=1, theta=np.pi/180, threshold=50,
            minLineLength=35, maxLineGap=5
        )

        frame_hough_yellow = self._image.copy()
        frame_hough = self._image.copy()

        if lines_yellow is not None:
            for line in lines_yellow:
                x1, y1, x2, y2 = line[0]
                cv2.line(frame_hough_yellow, (x1, y1), (x2, y2), (255, 0, 255), 2)

        lines_white = left_lines + right_lines
        if lines_white is not None:
            for line in lines_white:
                x1, y1, x2, y2 = line[0]
                cv2.line(frame_hough, (x1, y1), (x2, y2), (255, 255, 0), 2)

        # cv2.imshow("white hough", frame_hough)

        # <20250804> 체커 관련
        if lines_yellow is not None:
            left_lines_yellow, right_lines_yellow = self.filter_lines(
                lines_yellow, self.THRESHOLD_SLOPE_YELLOW, split_frame=False
            )
            lines_yellow_best = self.get_best_line(left_lines_yellow + right_lines_yellow)

            if lines_yellow_best is not None:
                frame_yellow_best = self._image.copy()
                x1, y1, x2, y2 = lines_yellow_best[0]
                cv2.line(frame_hough_yellow, (x1, y1), (x2, y2), (0, 255, 255), 2)

                self.flag_yellow_lane_detected = True
                slope_yellow = self.line_slope(lines_yellow_best)

                if slope_yellow > 0:
                    self.yellow_lane_is_on_your_right = True
                else:
                    self.yellow_lane_is_on_your_right = False

                if abs(slope_yellow) < self.CURVE_SLOPE_THRESHOLD:
                    self.is_on_curve = True
                else:
                    self.is_on_curve = False

                if self.yellow_lane_is_on_your_right:
                    best_line_left = self.get_best_line(left_lines)
                    best_line_right = lines_yellow_best 
                else:
                    best_line_left = lines_yellow_best
                    best_line_right = self.get_best_line(right_lines)
            else:
                self.flag_yellow_lane_detected = False
                best_line_left = self.get_best_line(left_lines)
