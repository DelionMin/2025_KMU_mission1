    def change_lane(self):
        self.yolo_list = self._detect_car()
        extra_car_detected = len(self.yolo_list)
        angle = 0
        
                
        #-------------------------------INIT state-----------------------
                
        # INIT
        # -angle, speed
        # 기본적으로 lane drive 주행 (라이다 거리가 self.EXTRA_CAR_DIST_THRESHOLD 이하가 되면 extra car 상대속도로 속도 고정)

        # -state 이동
        # 주어진 조건에 따라 각 state로 이동
        if self.state == self.INIT:
            #전방 레이더 값 받아오기
            center = self._ranges[self._front_indices]
            dist_min = self._get_valid_distance(center)
            
            #현재 차량 위치
            current_lane = self.detect_current_lane()
            #extra 차량 위치
            extra_car_lane = self.find_closeObstacle_lane()
            #side 차량 존재 여부
            side_car_detected = self._detect_sidecar()
            
            #follow lane 주행
            #angle, speed = follow_lane()
            

            # 차량 2개 인식, 챠량 1개 인식하는 감지 함수 만들 예정
            if side_car_detected == True:
                self.state = self.INIT
            else: 
                if (extra_car_detected >= 1):
                    if(extra_car_lane == current_lane):
                        self.state = self.DETECT_ONE_EXTRA_CAR
                        #print("1 car detected at the same lane. move to DETECT_ONE_EXTRA_CAR state")
                        #print(f"current lane: {current_lane}, extra car lane: {extra_car_lane}")
                    else:
                        self.state = self.INIT
                        #print("1 car detected at the different lane. move to Init state")
                        #print(f"current lane: {current_lane}, extra car lane: {extra_car_lane}")
                #extra car 검출 X 
                elif (extra_car_detected == 0):
                    self.state = self.INIT
                    #print("no car detected. stay at INIT state")

            #기본 주행 속도 & 앵글
            angle, speed = self.follow_lane()
            
                    
            
        #----------------------follow lane--------------------------
        # FOLLOW_YELLOW (추가된 state)
        # -angle, speed
        # 중앙선 물고가는 알고리즘
        # -state 이동
        # is_stabilized 상태(중앙선 맞춰진 상태)가 되면 DETECT_TWO_EXTRA_CAR state로 넘어감


        elif self.state == self.FOLLOW_YELLOW:
            print("self.FOLLOW_YELLOW")
            angle, is_stabilized = self._handle_yellow_follow_state()
            speed = self._calculate_following_speed(self._both_indices)
            
            if is_stabilized:
                self.state = self.DETECT_TWO_EXTRA_CAR
    
        #--------------------------2개 인식 스테이트--------------------------
        # DETECT_TWO_EXTRA_CAR
        # -angle, speed
        # 좌 우 라이다 값 비교해 self.RANGES_DIFFERENCE_THRESHOLD 값 이상이면 차선 변경
        # min_ranges_left > min_ranges_right => 우회전
        # min_ranges_left < min_ranges_right => 좌회전
        # 조향 조정은 self._handle_lane_return_state(self, lane) 이 메소드로 처리 (speed 반환 추가)
        # -state 이동
        # min_ranges_front > self.ESCAPE_DIST_THRESHOLD이면 INIT state로 넘어감
        
        elif self.state == self.DETECT_TWO_EXTRA_CAR:
           
            print("self.DETECT_TWO_EXTRA_CAR")
            # 좌우 라이다 부채꼴 값 받아오기
            ranges_left = self._ranges[self._left_indices]
            ranges_right = self._ranges[self._right_indices]
            # 좌우 라이다 최소 값 받아오기
            min_ranges_left = self._get_valid_distance(ranges_left)
            min_ranges_right = self._get_valid_distance(ranges_right)
            # 전방 레이더 값 받아오기
            ranges_escape_dist = self._ranges[self._lineEscape_indices]
            min_ranges_front = self._get_valid_distance(ranges_escape_dist)
            
            # 중앙선 추종
            angle, _ = self._handle_yellow_follow_state() 
            speed = self._calculate_following_speed(self._both_indices)
            
            # 중앙선 위에 올라온 상황으로 확보할 수 있도록 self.차이_유의미_THRESHOLD 튜닝
            if (abs(min_ranges_left - min_ranges_right) > self.RANGES_DIFFERENCE_THRESHOLD):
            
                if abs(min_ranges_left > min_ranges_right):
                    pass
                    #2차선으로 차선 변경
                    #angle, speed = self._handle_lane_return_state(2)
                    #print("move to left") 
                elif abs(min_ranges_right > min_ranges_left):
                    pass
                    #1차선으로 차선 변경
                    #angle, speed = self._handle_lane_return_state(1) 
                    #print("move to right")

                # 스테이트 분기 (탈출) 지점
                if (min_ranges_front > self.ESCAPE_DIST_THRESHOLD):
                    # 다시 INIT으로 돌아가서 
                    self.state = self.INIT
                    # change_lane 탈출
                    
                    self.flag_change_on = False
                    print("escape! move back to INIT state")
        
           
        #--------------------------1개 인식 스테이트------------------------------
        # 1개 인식 스테이트는 '내 차선'에 해당 차량이 있을 때만 state가 여기로 넘어오는 걸로 상정
        # INIT 함수에서 차 개수 셀 때 걸러주도록 구현 의도

        # DETECT_ONE_EXTRA_CAR
        # -angle, speed
        # detect_current_lane() == 1 => 우회전
        # detect_current_lane() == 2 => 좌회전
        # 조향 관련 메소드 만들 필요 있음. DETECT_TWO_EXTRA_CAR 에서 적용한 메소드는 중앙선 맞춰진 상태에서 조향하는 메소드. DETECT_ONE_EXTRA_CAR 이때는 1차선->2차선 이런 형식의 조향 해야함
        # -state 이동
        # min_ranges_front > self.ESCAPE_DIST_THRESHOLD 이면 INIT state로 넘어감
        elif self.state == self.DETECT_ONE_EXTRA_CAR:
            
            #print("NOW, IN 1 CAR DETECTION PHASE")
            
            # 전방 레이더 값 받아오기
            ranges_escape_dist = self._ranges[self._lineEscape_indices]
            min_ranges_front = self._get_valid_distance(ranges_escape_dist)
            center = self._ranges[self._front_indices]
            dist_min = self._get_valid_distance(center)


            #장애물과 충분히 가까운 경우 상대속도 적용
            if (dist_min < self.EXTRA_CAR_DIST_THRESHOLD): #self.TARGET_DISTANCE < self.EXTRA_CAR_DIST_THRESHOLD이어야 함
                speed = self._calculate_following_speed(self._front_indices)
                print("speed is following speed")
            
            if self.state_change == self.STATE_SAME_LANE_0:
                # closeObstacle_lane 값에 따라 차선 변경 방향 결정
                # 1: 오른쪽 차선, 2: 왼쪽 차선, 나머지는 에러..? 다시 탐색 필요
                if self.current_lane == 1:
