                angle, speed = self.follow_lane()
                
                self.state_change = self.STATE_SAME_LANE_1
                
            
            elif self.state_change == self.STATE_SAME_LANE_1:
                if dist_min <= self.APPROACH_DISTANCE:
                    self.state_change = self.STATE_SAME_LANE_2
                
                angle, speed = self.follow_lane()
                
            
            elif self.state_change == self.STATE_SAME_LANE_2:
                # 오른쪽으로 차선 변경
                if self.to_the_right:
                    # speed 오프셋은 추월 목적
                    # 2차선으로 차선변경 필요 but 중앙에서 시작하지 않아서 다른 메서드 
                    angle, speed = 35, 5	#self._calculate_following_speed(self._front_indices)
