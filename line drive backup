    def _get_valid_distance(self, ranges_subset):
        valid_ranges = ranges_subset[ranges_subset > self.MIN_VALID_DISTANCE]
        return valid_ranges.min() if valid_ranges.size > 0 else np.inf

    def _is_valid_line_coords(self, coords):
        return coords != (0, 0, 0, 0)
    
    def _safe_divide(self, numerator, denominator, default_value=0):
        if abs(denominator) < 1e-6:
            return default_value
        return numerator / denominator
        
    def _create_masked_image(self, image, target_lane, width):
        image_copy = image.copy()
        if target_lane == 1:
            image_copy[:, width // 2:] = (0, 0, 0) # 오른쪽 마스킹
        elif target_lane == 2:
            image_copy[:, :width // 2] = (0, 0, 0) # 왼쪽 마스킹
        return image_copy

