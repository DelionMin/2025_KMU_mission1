            self.flag_white_left_detected = best_line_left is not None
            self.flag_white_right_detected = best_line_right is not None

        if best_line_left is None:
            best_line_left = self.best_line_left_prev
            lane_color_left = self.COLOR_RED
        else:
            self.best_line_left_prev = best_line_left
            lane_color_left = self.COLOR_GREEN
        
        if best_line_right is None:
            best_line_right = self.best_line_right_prev
            lane_color_right = self.COLOR_RED
        else:
            self.best_line_right_prev = best_line_right
            lane_color_right = self.COLOR_GREEN

        if best_line_left is not None or best_line_right is not None:
            if best_line_left is None:
                self.valid_slope = abs(self.line_slope(best_line_right))
            elif best_line_right is None:
                self.valid_slope = abs(self.line_slope(best_line_left))
            else:
                self.valid_slope = abs(self.line_slope(best_line_right))
                if self.valid_slope > abs(self.line_slope(best_line_left)): 
                    self.valid_slope = abs(self.line_slope(best_line_left))

        if self.valid_slope < self.S_CURVE_SLOPE_THRESHOLD:
            self.drive_state = self.DRIVE_STATE_CURVE
        elif self.valid_slope < self.CURVE_SLOPE_THRESHOLD:
            self.drive_state = self.DRIVE_STATE_S_CURVE
        else:
            self.drive_state = self.DRIVE_STATE_STRAIGHT



        if self.drive_state == self.DRIVE_STATE_STRAIGHT:  
