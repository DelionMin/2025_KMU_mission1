    # 이름 바꾸기 => 
    def detect_yellow_line(self):
        """
        이름 바꾸자 -> detect_yellow_line
        gets: 이미지
        returns: lines_yellow -> 영상처리 후 허프 변환해서 얻은 선분들의 list를 처리해서 대표 직선 추출 후
        [[x1,y1,x2,y2]] 형태로 반환

        e.g. 
        yellow_array = self.detect_yellow_line()
        yellow_coords = yellow_array[0]
        """


            # 이미지 hsv 형태로 변환
        hsv_yellow = cv2.cvtColor(self._image, cv2.COLOR_BGR2HSV)

            # 노란색 범위 상, 하한선

        mask_yellow = cv2.inRange(hsv_yellow, self.lower_yellow, self.upper_yellow)
        yellow_parts = cv2.bitwise_and(self._image, self._image, mask=mask_yellow)

        gray_yellow = cv2.cvtColor(yellow_parts, cv2.COLOR_BGR2GRAY)
        blur_yellow = cv2.GaussianBlur(gray_yellow, (5, 5), 0)
            
        edges_yellow = cv2.Canny(blur_yellow, 50, 150)


        roi_yellow_edges = self.region_of_interest(edges_yellow, self.roi_vertices)

        lines_yellow = cv2.HoughLinesP(roi_yellow_edges, rho=1, theta=np.pi/180, threshold=50, minLineLength=35, maxLineGap=5) 
            
        if lines_yellow is not None:
            # 노란 선분 정제
            left_lines_yellow, right_lines_yellow = self.filter_lines(lines_yellow, self.THRESHOLD_SLOPE_YELLOW, False)
                    # <20250801> 인식된 노란 차선들 중 최고의 선 추출
            lines_yellow_best = self.get_best_line(left_lines_yellow + right_lines_yellow)
                        # <20250801> 노란 차선 반영
            
            
            if lines_yellow_best is not None:
                self.y_x1 = lines_yellow_best[0][0]
                self.y_y1 = lines_yellow_best[0][1]
                self.y_x2 = lines_yellow_best[0][2]
                self.y_y2 = lines_yellow_best[0][3]
                
                return lines_yellow_best
            
            
            else:
                return [[0,0,0,0]]
        elif lines_yellow is None:
            return [[0,0,0,0]]


# 걍 detect white 에서 이름이랑 색깔값만 바꾼거
    def detect_white_line(self,image_white):
        """
        이름 바꾸자 -> detect_white_line
        gets: 이미지
        returns: lines_white -> 영상처리 후 허프 변환해서 얻은 선분들의 list를 처리해서 대표 직선 추출 후
        [[x1,y1,x2,y2]] 형태로 반환

        e.g. 
        white_array = self.detect_white_line()
        white_coords = white_array[0]
        """


        # RoI(Region of Interest)의 좌표를 나타내는 np.array
        roi_vertices = np.array([[
            (self.width_frame * 0, self.height_frame),
            (self.width_frame * 0.3, self.height_frame * 0.6),
            (self.width_frame * 0.7, self.height_frame * 0.6),
            (self.width_frame * 1, self.height_frame)
        ]], dtype=np.int32)

        # 이미지 hsv 형태로 변환
        hsv_white = cv2.cvtColor(image_white, cv2.COLOR_BGR2HSV)

        # 노란색 범위 상, 하한선


        mask_white = cv2.inRange(hsv_white, self.lower_white, self.upper_white)
        white_parts = cv2.bitwise_and(image_white, image_white, mask=mask_white)

        gray_white = cv2.cvtColor(white_parts, cv2.COLOR_BGR2GRAY)
        blur_white = cv2.GaussianBlur(gray_white, (5, 5), 0)
        edges_white = cv2.Canny(blur_white, 50, 150)

        roi_white_edges = self.region_of_interest(edges_white, roi_vertices)

        lines_white = cv2.HoughLinesP(roi_white_edges, rho=1, theta=np.pi/180, threshold=50,
                            minLineLength=35, maxLineGap=5) 
        
        if lines_white is not None:
            # 흰 선분 정제
            left_lines_white, right_lines_white = self.filter_lines(lines_white, self.THRESHOLD_SLOPE_YELLOW, False)
                    # <20250801> 인식된 노란 차선들 중 최고의 선 추출
            lines_white_best = self.get_best_line(left_lines_white + right_lines_white)
                        # <20250801> 노란 차선 반영
            
            
            if lines_white_best is not None:
                self.w_x1 = lines_white_best[0][0]
                self.w_y1 = lines_white_best[0][1]
                self.w_x2 = lines_white_best[0][2]
                self.w_y2 = lines_white_best[0][3]
                
                return lines_white_best
            
            
            else:
                return [[0,0,0,0]]
        elif lines_white is None:
            return [[0,0,0,0]]
        
    
