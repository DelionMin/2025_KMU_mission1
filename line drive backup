        if self.cursor_left is not None and self.cursor_right is not None:
            self.cursor_left = list(self.cursor_left)
            self.cursor_right = list(self.cursor_right)
        
            if self.flag_yellow_lane_detected:
                if self.is_on_curve:
                    if self.yellow_lane_is_on_your_right:
                        self.cursor_left[0] = self.cursor_right[0] - self.lane_width_curve
