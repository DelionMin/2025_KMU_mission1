  def change_lane(self,image):
    angle = 0
    speed = 10
    
    if self.state == self.INIT:

      self.height, self.width = image.shape[:2]
      
      self.lane_constant = self.count_lanes(image,self.height, self.width)
      if self.lane_constant==0:
        pass  

      elif self.lane_constant in (1, 2):
        if self.lane_constant == self.count_lanes(image,self.height, self.width): #한번더 확인 정확도 높으면 지우기

          if self.lane_constant == 1: # 1차선이면 LtR
            self.state = self.CHANGE_STATE_1to2
          elif self.lane_constant == 2: # 2차선이면 RtL
            self.state = self.CHANGE_STATE_2to1
        else:
          self.lane_constant = 0


    elif self.state == self.CHANGE_STATE_1to2:
    
      image = self._image    
      angle = self.change_lane_1to2(image)
      


    elif self.state == self.CHANGE_STATE_2to1:
      image = self._image    
      angle = self.change_lane_2to1(image)  
    
    
    return angle,speed

  def step(self):
    angle, speed = self.change_lane()
    return angle, speed
