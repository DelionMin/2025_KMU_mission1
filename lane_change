  def count_lanes(self, image, height, width):  # 현재 차선 판별
    lane_constant=0
    roi_left = np.array([[   # 왼쪽 사다리꼴 절반
        (width * 0.1, height),
        (width * 0.3, height * 0.6),
        (width * 0.5, height * 0.6),
        (width * 0.5, height)
    ]], dtype=np.int32)
    
    left_color = self.lane_color_detection(image, roi_left)

    # 오른쪽
    roi_right = np.array([[   # 오른쪽 사다리꼴 절반
        (width * 0.5, height),
        (width * 0.5, height * 0.6),
        (width * 0.7, height * 0.6),
        (width * 0.9, height)
    ]], dtype=np.int32)
    
    right_color = self.lane_color_detection(image, roi_right)

    

    if (left_color == 'white') and (right_color == 'yellow'): # 1차선
      lane_constant = 1
    
    elif (left_color == 'yellow') and (right_color == 'white'): # 2차선
      lane_constant = 2
    
    elif (left_color == 'white') and (right_color == 'white'): # error
      lane_constant = 0

    elif (left_color == 'yellow') and (right_color == 'yellow'): # error
      lane_constant = 0

    return lane_constant

