    '''
    메소드 이름: calculate_abc
    입력: x1,y1,x2,y2
    출력: 입력받은 x1,y1,x2,y2 값에 해당하는 a, b, c 값 반환 (ax+by+c=0)
    역할: 직선의 두 점 좌표를 받아서 a,b,c 값으로 변환 (ax+by+c=0)
    ''' 

    def calculate_abc(self, x1, y1, x2, y2):

        # 좌표로부터 a,b,c 값 추출
        # ax + by + c = 0
        a_coef = y1 - y2
        b_coef = x2 - x1
        c_coef = x1 * y2 - x2 * y1

        return a_coef, b_coef, c_coef 




    
