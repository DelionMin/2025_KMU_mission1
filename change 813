    def change_lane(self):
        self.yolo_list = self._detect_car()
        self.results = self._get_yolo_results()
        extra_car_detected = len(self._detect_car())
        angle = 0
        
        current_state = self.state
        #-------------------------------INIT state-----------------------
        if self.state == self.INIT:
          #전방 레이더 값 받아오기
          center = self._ranges[self._front_indices]
          dist_min = self._get_valid_distance(center)
          
          #현재 차량 위치
          current_lane = self.detect_current_lane()
          #extra 차량 위치
          extra_car_lane = self.find_closeObstacle_lane()
          #side 차량 존재 여부
          side_car_detected = self._detect_sidecar()
          

          # 차량 2개 인식, 챠량 1개 인식하는 감지 함수 만들 예정
          if side_car_detected == True:
            self.state = self.INIT
          else: 
            #extra car 2개 검출
            if (extra_car_detected >= 2):
              self.state = self.DETECT_TWO_EXTRA_CAR
              print("more then 2 car detected. move to DETECT_TWO_EXTRA_CAR state")
            #extra car 1개 검출
            elif (extra_car_detected == 1):
              if(extra_car_lane == current_lane):
                self.state = self.DETECT_ONE_EXTRA_CAR
                print("1 car detected at the same lane. move to DETECT_TWO_EXTRA_CAR state")
              else:
                self.state = self.INIT
                print("1 car detected at the different lane. move to DETECT_TWO_EXTRA_CAR state")
            #extra car 검출 X 
            elif (extra_car_detected == 0):
              self.state = self.INIT
              print("no car detected. stay at INIT state")
  
          if (dist_min < self.EXTRA_CAR_DIST_THRESHOLD): #self.TARGET_DISTANCE < self.EXTRA_CAR_DIST_THRESHOLD이어야 함
            pass
            
      #--------------------------2개 인식 스테이트--------------------------
          
        elif self.state == self.DETECT_TWO_EXTRA_CAR:
    
          # 좌우 라이다 부채꼴 값 받아오기
          ranges_left = self._ranges[self._left_indices]
          ranges_right = self._ranges[self._right_indices]

          # 좌우 라이다 최소 값 받아오기
          min_ranges_left = self._get_valid_distance(ranges_left)
          min_ranges_right = self._get_valid_distance(ranges_right)
          
          
            # 중앙선 위에 올라온 상황으로 확보할 수 있도록 self.차이_유의미_THRESHOLD 튜닝
          if (abs(min_ranges_left - min_ranges_right) > self.RANGES_DIFFERECE_THRESHOLD):
              
              # 차선 변경 대상 차로 확보 -> 1개 인식 스테이트에서 실질적 추월 수행
              self.state = self.DETECT_ONE_EXTRA_CAR
          
          else:
            angle = self._handle_yellow_follow_state() #중앙선 추종
            speed = self._calculate_following_speed(self._both_indices)
          
      #--------------------------1개 인식 스테이트------------------------------
         # 1개 인식 스테이트는 '내 차선'에 해당 차량이 있을 때만 state가 여기로 넘어오는 걸로 상정
          # INIT 함수에서 차 개수 셀 때 걸러주도록 구현 의도
        elif self.state == self.DETECT_ONE_EXTRA_CAR:

          # 전방 레이더 값 받아오기
          ranges_escape_dist = self._ranges[self._lineEscape_indices]
          min_ranges_front = self._get_valid_distance(ranges_escape_dist)

          # closeObstacle_lane 값에 따라 차선 변경 방향 결정
          # 1: 오른쪽 차선, 2: 왼쪽 차선, 나머지는 에러..? 다시 탐색 필요
          if self.detect_current_lane() == 1:
              self.to_the_right = True 
          elif self.detect_current_lane() == 2:
              self.to_the_right = False
          else:
              print("ERROR! can't detect my current lane.")


          # 스테이트 분기 (탈출) 지점
          if (min_ranges_front > self.ESCAPE_DIST_THRESHOLD):
              # 다시 INIT으로 돌아가서 
              self.state = self.INIT

          # 오른쪽으로 차선 변경
          if self.to_the_right:
              # speed 오프셋은 추월 목적
              print("move to right")
          # 왼쪽으로 차선 변경
          else:
              # speed 오프셋은 추월 목적
              print("move to left")
        
        return angle, speed

