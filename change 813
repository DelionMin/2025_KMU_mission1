    def detect_yellow_line(self):
        """
        이름 바꾸자 -> detect_yellow_line
        gets: 이미지
        returns: lines_yellow -> 영상처리 후 허프 변환해서 얻은 선분들의 list를 처리해서 대표 직선 추출 후
        [[x1,y1,x2,y2]] 형태로 반환

        e.g. 
        yellow_array = self.detect_yellow_line()
        yellow_coords = yellow_array[0]
        """

        image_yellow = self._image

        # RoI(Region of Interest)의 좌표를 나타내는 np.array
        roi_vertices = np.array([[
            (self.width_frame * 0, self.height_frame),
            (self.width_frame * 0.3, self.height_frame * 0.6),
            (self.width_frame * 0.7, self.height_frame * 0.6),
            (self.width_frame * 1, self.height_frame)
        ]], dtype=np.int32)

        # 이미지 hsv 형태로 변환
        hsv_yellow = cv2.cvtColor(image_yellow, cv2.COLOR_BGR2HSV)

        # 노란색 범위 상, 하한선


        mask_yellow = cv2.inRange(hsv_yellow, self.lower_yellow, self.upper_yellow)
        yellow_parts = cv2.bitwise_and(image_yellow, image_yellow, mask=mask_yellow)

        gray_yellow = cv2.cvtColor(yellow_parts, cv2.COLOR_BGR2GRAY)
        blur_yellow = cv2.GaussianBlur(gray_yellow, (5, 5), 0)
        edges_yellow = cv2.Canny(blur_yellow, 50, 150)

        roi_yellow_edges = self.region_of_interest(edges_yellow, roi_vertices)

        lines_yellow = cv2.HoughLinesP(roi_yellow_edges, rho=1, theta=np.pi/180, threshold=50,
                            minLineLength=35, maxLineGap=5) 
        
        if lines_yellow is not None:
            # 노란 선분 정제
            left_lines_yellow, right_lines_yellow = self.filter_lines(lines_yellow, self.THRESHOLD_SLOPE_YELLOW, is_white = False)
                    # <20250801> 인식된 노란 차선들 중 최고의 선 추출
            lines_yellow_best = self.get_best_line(left_lines_yellow + right_lines_yellow)
                        # <20250801> 노란 차선 반영
            
            
            if lines_yellow_best is not None:
                self.y_x1 = lines_yellow_best[0][0]
                self.y_y1 = lines_yellow_best[0][1]
                self.y_x2 = lines_yellow_best[0][2]
                self.y_y2 = lines_yellow_best[0][3]
                
                return lines_yellow_best
            
            
            else:
                return [[0,0,0,0]]
        elif lines_yellow is None:
            return [[0,0,0,0]]


