    def filter_lines(self, lines_unfiltered, slope_threshold, is_white):
      """
      <gets>
      lines_unfiltered: HoughlinesP로 감지된 선분들 
      slope: 차선 가능성 있는 선분들 걸러내기 위한 기울기 threshold
      <returns>
      left_lines: 왼쪽 차선 정보를 담은 선분들의 집합
      right_lines: 오른쪽 차선 정보를 담은 선분들의 집합
      """
      # <20250804> '기울기 반대 직선' 거르기 -> 기능 구현 필요

      # Q. 기울기 반대 직선?

      # A. 화면 왼쪽에 인식된 직선은 ('/') 모양이어야 한다 -> ('/') 이 모양은 기울기 (음수), 
      # 따라서 기울기가 (음수)일 때 두 점의 x1, x2, 좌표가 모두 화면 (오른쪽)에 있을 때의 직선은 걸러내기
      # *괄호에 대해 Vice versa

      # 왼쪽, 오른쪽 차선 넣어둘 리스트
      left_lines = []
      right_lines = []

      if lines_unfiltered is not None:
        for line in lines_unfiltered:
          x1, y1, x2, y2 = line[0]

          # 수직선은 제외
          if x2 - x1 == 0:
            continue
          slope = (y2 - y1) / (x2 - x1)

          # 기울기가 작은 직선들은 제외
          if abs(slope) < slope_threshold:
            continue

          # 기울기 부호로 좌, 우측 판정
          # ***< 영상처리 시 Y값의 경우 아래로 갈수록 커진다는 점 유의 >***
          if slope < 0:
            # '/' 모양 직선은 화면 왼쪽에만 인식되도록
            if is_white:
              if x1 < (self.width_frame // 2) and x2 < (self.width_frame // 2):
                left_lines.append(line)
            
            else:
              left_lines.append(line)
          
          else:
            # '\' 모양 직선은 화면 오른쪽에만 인식되도록
            if is_white: 
              if x1 > (self.width_frame // 2) and x2 > (self.width_frame // 2):
                right_lines.append(line)
            
            else:
              right_lines.append(line)

      return left_lines, right_lines
   
    def region_of_interest(self, img, vertices):
      '''
      vertices 범위 밖 값들은 다 0으로 만들어 mask를 씌우는 함수
      '''
      mask = np.zeros_like(img)
      if len(img.shape) > 2:
      # channel이 여러 개인 경우 (e.g. BGR은 channel 3개)
        channel_count = img.shape[2]
        ignore_mask_color = (255,) * channel_count
      else:
        ignore_mask_color = 255

      # mask에 vertices 모양대로 ignore_mask_color 값 넣음
      cv2.fillPoly(mask, [vertices], ignore_mask_color)

      # img, mask에 bitwise_and 연산 해서 겹치지 않는 부분은 0으로
      masked_image = cv2.bitwise_and(img, mask)
      
      # 어케 나오는지 궁금하면 이거 기
      # cv2.imshow("masked_image", masked_image)

      return masked_image
        
    '''
    메소드 이름: get_best_line
    입력: lines
    출력: best_line
    역할: 여러 line 중 best_line 추출
    '''
    def get_best_line(self, lines): 
        '''
        입력된 선들 중에서 대푯값 추출
        gets: [[x1, y1, x2, y2], [x1, y1, x2, y2], ...]
        returns: [[x1, y1, x2, y2]]

        *** 검증 필요 ***
        '''
        best_line = None
        m_left, b_left = 0.0, 0.0
        x_sum, y_sum, m_sum = 0.0, 0.0, 0.0

        size = len(lines)
        if size != 0:
            for line in lines:
                x1, y1, x2, y2 = line[0]
                x_sum += x1 + x2
                y_sum += y1 + y2
                if(x2 != x1):
                    m_sum += float(y2-y1)/float(x2-x1)
                else:
                    m_sum += 0
            
            x_avg = x_sum / (size*2)
            y_avg = y_sum / (size*2)
            m_left = m_sum / size
            b_left = y_avg- m_left * x_avg
        
        if m_left != 0.0:
            y1 = 0
            y2 = self.height_frame
            '''
            y1, y2 실제 주행 환경에서는 값 맞춰서 바꾸기
            '''

            x1 = int((y1 - b_left) / m_left)
            x2 = int((y2 - b_left) / m_left)

            best_line = [[x1, y1, x2, y2]]

        return best_line
    
    def line_slope(self, line):
      """
      Calculate slope of a line in format [[x1, y1, x2, y2]].
      Returns float('inf') if the line is vertical.
      """
      x1, y1, x2, y2 = line[0]
      
      if x2 - x1 == 0: # Vertical line
          return float('inf')
      
      return (y2 - y1) / (x2 - x1)
          
