    '''
    초음파 센서를 이용하여 측면 차량 감지
    입력: 초음파 센서 데이터
    출력: 측면 차량 감지 결과 (크기가 8인 초음파 센서 데이터 배열로 좌측부터 시계방향으로 0, 1, 2, 3, 4, 5, 6, 7 인덱스에 해당하는 값)
    역할: 초음파 센서를 통해 측면 차량을 감지하고 해당 방향을 반환
    '''
    def _detect_sidecar(self):
        current_lane = self.detect_current_lane()
        ultrasonic = self._ultrasonic

        if ultrasonic is None:
            print("Ultrasonic data is not available.") 
            return False
        if current_lane == 2:
          if ultrasonic[0] < self.SUPER_THRESHOLD:
            print("Right side car detected.")
            return True
        elif current_lane == 1:
          if ultrasonic[4] < self.SUPER_THRESHOLD:
            print("Left side car detected.")
            return True
        

    '''
    욜로를 이용한 차량 감지
    입력: 이미지
    출력: 엑스트라 차향이 감지되고 신뢰도가 일정 이상 높으면 좌표와 크기 정보
    역할: YOLO 모델을 사용하여 이미지에서 차량을 감지하고 해당 정보를 반환
    '''
    def _detect_car(self):
        if self._image is None: return []
        detected_boxes = []
        try:
            results = model(self._image, verbose=False)
            for result in results:
                for box in result.boxes:
                    confidence = float(box.conf[0])
                    class_id = int(box.cls[0])
                    if confidence > self.confidence_threshold and class_id == self.class_names['car']:
                        x1, y1, x2, y2 = box.xyxy[0].cpu().numpy()
                        detected_boxes.append({'center': [(x1 + x2) / 2, (y1 + y2) / 2],
                                               'width': x2 - x1, 'height': y2 - y1})
            return detected_boxes
        except Exception as e:
            print(f"Error in _detect_car: {e}")
            return []
      

    def _get_yolo_results(self):
        if self._image is None: return []
        try:
            return model(self._image, verbose=False)
        except Exception as e:
            print(f"Error in _get_yolo_results: {e}")
            return []

    def find_closeObstacle_lane(self):
        yolo_list = self._detect_car()
        if not yolo_list: return 0
        closest_car = yolo_list[0]
        car_center_x, car_center_y = closest_car['center']
        car_height = closest_car['height']
        
        yellow_coords = self.find_yellow(self._image)
        if not self._is_valid_line_coords(yellow_coords): return 0
        yellow_a, yellow_b, yellow_c = self.calculate_abc(*yellow_coords)
        
        car_bottom_y = car_center_y + car_height / 2
        yellow_x = self._safe_divide(-yellow_c - yellow_b * car_bottom_y, yellow_a, np.inf)

        if yellow_x > car_center_x: return 1 # 1차선
        elif yellow_x < car_center_x: return 2 # 2차선
        else: return 0
   
          
    def _detect_lane_change(self) -> bool:
        # 차선 변경 유무를 판단하는 로직
        if len(self._detect_car()) > 0:
            self.flag_change_on = True
        else:
            self.flag_change_on = False
    # --------------------------------------------------
    # 주행 제어 로직 메서드 (분리)
    # --------------------------------------------------

    def _calculate_following_speed(self, lidar_ranges):
        center = self._ranges[lidar_ranges]
        self.dist_min = self._get_valid_distance(center)
        car_pid = self.car_following_pid
        car_pid['error'] = self.dist_min - self.TARGET_DISTANCE
        derivative = (car_pid['error'] - car_pid['prev_error'])
        speed = car_pid['min_Kp'] * car_pid['error'] + car_pid['min_Kd'] * derivative
        car_pid['prev_error'] = car_pid['error']
        return max(0, speed)


    def _handle_yellow_follow_state(self):
        yellow_coords = self.find_yellow(self._image)
        if not self._is_valid_line_coords(yellow_coords): 
            return 0, False, None
        
        a_coef, b_coef, c_coef = self.calculate_abc(*yellow_coords)
        if a_coef == 0 and b_coef == 0: 
            return 0, False, None

        lane_pid = self.lane_following_pid
        x_bottom = self._safe_divide(-(c_coef + b_coef * self.height_frame), a_coef, self.width_frame / 2)
        position_error = self.width_frame / 2 - x_bottom
        position_derivative = position_error - lane_pid['prev_error1']
        
        slope = self._safe_divide(-a_coef, b_coef)
        angle_error = 0 - slope
        angle_derivative = angle_error - lane_pid['prev_error2']

        angle = (lane_pid['Kp'] * position_error + lane_pid['Kd'] * position_derivative +
                 lane_pid['Kpa'] * angle_error + lane_pid['Kda'] * angle_derivative)

        lane_pid['prev_error1'] = position_error
        lane_pid['prev_error2'] = angle_error
        
        # is_stabilized = abs(position_error) < self.STABILIZATION_POSITION_THRESHOLD and abs(angle_error) < self.STABILIZATION_ANGLE_THRESHOLD
        
        return angle #, is_stabilized, None

    def _handle_detect_state(self):
        obstacle_lane = self.find_closeObstacle_lane()
        return 0, obstacle_lane, None

    def _handle_lane_return_state(self, target_lane):
        yellow_coords = self.find_yellow(self._image)
        white_coords = self.find_white(self._create_masked_image(self._image, target_lane, self.width_frame))
        
        if not self._is_valid_line_coords(yellow_coords) or not self._is_valid_line_coords(white_coords):
            return 0, False, None
        
        yellow_a, yellow_b, yellow_c = self.calculate_abc(*yellow_coords)
        white_a, white_b, white_c = self.calculate_abc(*white_coords)
        
        lane_pid = self.lane_changing_pid
        
        target_pos = self.width_frame / 2
        yellow_x = self._safe_divide(-(yellow_c + yellow_b * self.height_frame), yellow_a, self.width_frame / 2)
        white_x = self._safe_divide(-(white_c + white_b * self.height_frame), white_a, self.width_frame / 2)
        current_pos = (yellow_x + white_x) / 2
        
        error_pos = target_pos - current_pos
        derivative_pos = error_pos - lane_pid['prev_error']

        yellow_slope = self._safe_divide(-yellow_a, yellow_b)
        white_slope = self._safe_divide(-white_a, white_b)
        error_angle = 0 - (yellow_slope + white_slope)

        angle = lane_pid['Kp'] * error_pos + lane_pid['Kd'] * derivative_pos - lane_pid['Ka'] * error_angle
        lane_pid['prev_error'] = error_pos
        
        return angle, None

    def _handle_sidedrive_state(self):
        # 차선 추종 로직 (yellow_follow와 유사)
        yellow_coords = self.find_yellow(self._image)
        angle = 0
        if self._is_valid_line_coords(yellow_coords):
            a_coef, b_coef, c_coef = self.calculate_abc(*yellow_coords)
            if a_coef != 0 or b_coef != 0:
                lane_pid = self.lane_following_pid # 여기서는 일반 차선 추종 PID 사용
                x_bottom = self._safe_divide(-(c_coef + b_coef * self.height_frame), a_coef, self.width_frame / 2)
                position_error = self.width / 2 - x_bottom
                angle = lane_pid['Kp'] * position_error # 간단한 P 제어만 사용

        return angle

    def _debug_visualization(self, image, results):
        if not results: return
        image_with_boxes = image.copy()
        for result in results:
            for box in result.boxes:
                x1, y1, x2, y2 = map(int, box.xyxy[0])
                label = model.names[int(box.cls[0])]
                cv2.rectangle(image_with_boxes, (x1, y1), (x2, y2), (0, 255, 0), 2)
                cv2.putText(image_with_boxes, label, (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
        
        if self.y_x1 != 0 or self.y_x2 != 0:
            cv2.line(image_with_boxes, (self.y_x1, self.y_y1), (self.y_x2, self.y_y2), (0, 255, 0), 2)
        # if self.w_x1 != 0 or self.w_x2 != 0:
        #     cv2.line(image_with_boxes, (self.w_x1, self.w_y1), (self.w_x2, self.w_y2), (0, 255, 0), 2)
        
        cv2.imshow("YOLO Result", image_with_boxes)
        

